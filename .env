# .env : valeurs par défaut de l'application, modifiables sans toucher au code.
# Toutes ces variables ont un repli codé dans main.py si le fichier est absent ou incomplet.

# Facteur de redondance pré-rempli par défaut à l'étape "redondance" de l'encodage (l'utilisateur peut
# saisir n'importe quel entier >= 1, il n'y a pas de liste figée : la seule limite est celle du format
# de fichier, 255, car N est stocké sur 1 octet dans l'en-tête caché — voir stego_layer.py)
REDONDANCE_PAR_DEFAUT=1

# Taille (en bits) des clés RSA générées automatiquement quand l'utilisateur ne fournit pas sa propre clé
RSA_TAILLE_CLE_BITS=2048

# Pourcentage de pixels corrompus utilisé par défaut par le bouton "Comparer" (test de robustesse)
COMPARER_CORRUPTION_POURCENTAGE=5
# Facteurs de redondance testés par le bouton "Comparer" (liste séparée par des virgules)
COMPARER_FACTEURS_N=1,2,3
# Nombre d'essais de corruption moyennés par le bouton "Comparer" (un seul essai serait trop dépendant du hasard)
COMPARER_NB_ESSAIS=15
